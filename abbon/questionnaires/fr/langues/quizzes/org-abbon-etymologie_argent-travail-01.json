                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Pecus",
                      "marks": [
                        {
                          "type": "italic"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ", le bétail : la richesse se comptait d'abord en têtes de troupeau"
