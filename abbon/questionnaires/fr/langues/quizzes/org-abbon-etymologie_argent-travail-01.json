                {
                  "type": "text",
                  "text": "cattle",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": " (bétail) et "
                },
                {
                  "type": "text",
                  "text": "chattel",
                  "marks": [
                    {
                      "type": "italic"
                    }
