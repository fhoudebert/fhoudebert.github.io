      "points": 1,
      "position": 1,
      "explanation": {
        "fr": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "content": [
                {
                  "type": "text",
                  "text": "Chez les Romains comme chez bien d'autres peuples, le troupeau était la première forme de fortune et d'échange. "
                },
                {
                  "type": "text",
                  "text": "Peculium",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ", le petit pécule de l'esclave ou du fils de famille, vient de la même racine. « Péché », lui, vient de "
                },
                {
                  "type": "text",
                  "text": "peccatum",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ", sans rapport."
                }
              ]
            }
          ]
        }
      },
