                  "type": "text",
                  "text": " (bien meuble). « Chapitre » vient bien de "
                },
                {
                  "type": "text",
                  "text": "caput",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ", mais par un autre chemin ("
                },
                {
                  "type": "text",
                  "text": "capitulum",
                  "marks": [
                    {
                      "type": "italic"
                    }
                  ]
                },
                {
                  "type": "text",
                  "text": ", petite tête, titre)."
                }
