    {
      "id": "org-abbon-etymologie_noms-propres-01_guillotine",
      "type": "single",
      "prompt": {
        "fr": "Que peut-on dire du docteur Joseph-Ignace Guillotin ?"
      },
      "points": 1,
      "position": 2,
      "explanation": {
        "fr": "Le chirurgien Antoine Louis et le facteur de clavecins Tobias Schmidt mettent au point la machine en 1792 ; on l'appelle d'abord « louisette ». Guillotin, mort dans son lit en 1814, n'en fut pas victime, contrairement à la légende. Sa famille demanda en vain un changement de nom de l'instrument, puis changea de nom elle-même."
      },
      "choices": [
        {
          "id": "org-abbon-etymologie_noms-propres-01_guillotine_c1",
          "content": {
            "fr": "Il a proposé en 1789 une mort identique pour tous les condamnés, par une machine, mais ne l'a pas conçue ; son nom lui fut attaché malgré lui"
          },
          "correct": true,
          "position": 0,
          "feedback": null
        },
        {
          "id": "org-abbon-etymologie_noms-propres-01_guillotine_c2",
          "content": {
            "fr": "Il a inventé la machine et en fut la première victime"
          },
          "correct": false,
          "position": 1,
          "feedback": null
        },
        {
          "id": "org-abbon-etymologie_noms-propres-01_guillotine_c3",
          "content": {
            "fr": "Il était le bourreau de Paris sous la Révolution"
          },
          "correct": false,
          "position": 2,
          "feedback": null
        },
        {
          "id": "org-abbon-etymologie_noms-propres-01_guillotine_c4",
          "content": {
            "fr": "Il l'a fabriquée dans son atelier de menuiserie"
          },
          "correct": false,
          "position": 3,
          "feedback": null
        }
      ]
    },
